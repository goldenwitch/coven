<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ConsoleClaudeFileSystem</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <!-- Prefer local projects when toggled; otherwise use published packages -->
  <ItemGroup Condition="'$(PreferProjectReferences)' == 'true'">
    <ProjectReference Include="..\..\Coven.Chat.Console\Coven.Chat.Console.csproj" />
    <ProjectReference Include="..\..\Coven.Agents.Claude\Coven.Agents.Claude.csproj" />
    <ProjectReference Include="..\..\Coven.FileSystem.Posix\Coven.FileSystem.Posix.csproj" />
    <ProjectReference Include="..\..\Coven.Agents.FileSystem\Coven.Agents.FileSystem.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(PreferProjectReferences)' != 'true'">
    <PackageReference Include="Coven.Chat.Console" />
    <PackageReference Include="Coven.Agents.Claude" />
    <PackageReference Include="Coven.FileSystem.Posix" />
    <PackageReference Include="Coven.Agents.FileSystem" />
  </ItemGroup>

</Project>
